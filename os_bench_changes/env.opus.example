# OpenScientist rebuild for the case study 3 controls (base e0dc8421 + the 5 fix branches in the authors' benchmark notes)
OPENSCIENTIST_PROVIDER=anthropic
OPENSCIENTIST_HARNESS=claude_code
OPENSCIENTIST_MODEL=claude-opus-4-8
VLLM_BASE_URL=https://openrouter.ai/api/v1
VLLM_API_KEY=<set-your-own>
OPENSCIENTIST_AIRGAPPED=false
OPENSCIENTIST_DEV_MODE=true
OPENSCIENTIST_USE_CONTAINER_ISOLATION=true
OPENSCIENTIST_HOST_PROJECT_DIR=<absolute path of your openscientist checkout>
PORT=8081
POSTGRES_USER=openscientist
POSTGRES_PASSWORD=<set-your-own>
POSTGRES_DB=openscientist
POSTGRES_PORT=5435
OPENSCIENTIST_SECRET_KEY=<set-your-own>
ANTHROPIC_API_KEY=<set-your-own>
ANTHROPIC_BASE_URL=https://openrouter.ai/api
ANTHROPIC_SMALL_FAST_MODEL=claude-haiku-4-5
OPENSCIENTIST_MODEL_CONTEXT_TOKENS=200000
